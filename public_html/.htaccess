# ============================================================================
# SocietyOS — Hostinger Apache / LiteSpeed Configuration (.htaccess)
# ============================================================================
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
  # Prevent caching of index.html so updates are immediate on reload
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache hashed JS and CSS assets permanently
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]

  # Allow direct access to existing files (js, css, images, svg, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all /api/* requests to api/index.php gateway (prevents HTML fallback)
  RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]
  RewriteRule ^api$ api/index.php [QSA,L]

  # Route all SPA pages to index.html
  RewriteRule . /index.html [L]
</IfModule>

Options -Indexes
