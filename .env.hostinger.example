# ============================================================================
# SocietyOS — Hostinger Production Environment Configuration (.env)
# Copy or rename this file to `.env` in your Hostinger project root directory
# ============================================================================

NODE_ENV=production
PORT=4000

# ----------------------------------------------------------------------------
# 1. HOSTINGER MYSQL DATABASE CONFIGURATION
# Create a MySQL database in Hostinger hPanel -> Databases -> Management
# Import `database/mysql_schema.sql` via phpMyAdmin, then fill in details below:
# ----------------------------------------------------------------------------
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=u123456789_societyos
MYSQL_USER=u123456789_admin
MYSQL_PASSWORD=YOUR_MYSQL_DATABASE_PASSWORD

# ----------------------------------------------------------------------------
# 2. JWT & SECURITY SECRET
# ----------------------------------------------------------------------------
JWT_SECRET=societyos_production_jwt_secret_change_this_in_hostinger_2026

# ----------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# (Can also be customized dynamically from Super Admin & Society Admin Settings)
# ----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_TpIGmZQJ7x3t3P
RAZORPAY_KEY_SECRET=J855unI9vpDKw3WpzStw8Bru
VITE_RAZORPAY_KEY_ID=rzp_test_TpIGmZQJ7x3t3P
