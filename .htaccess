# ============================================================================
# SocietyOS — Hostinger Apache / LiteSpeed Configuration (.htaccess)
# Compatible with Hostinger Shared, Cloud, and Business Web Hosting
# ============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Do not rewrite if the file or folder exists directly in root
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. If the requested asset exists inside dist/ (e.g. /assets/*, favicon, etc.), serve from dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 3. Route all SPA pages to dist/index.html if dist/ exists
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^(.*)$ dist/index.html [L]

  # 4. Fallback to root index.html
  RewriteRule ^(.*)$ index.html [L]
</IfModule>

# Prevent directory listings
Options -Indexes
